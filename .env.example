# AI Provider: "demo" (default, offline) or "live" (requires API key)
VITE_AI_PROVIDER=demo

# Only needed when VITE_AI_PROVIDER=live
# Add your key to .env.local — NEVER commit .env.local
VITE_GEMINI_API_KEY=

# Google Authentication Client ID
# Example: 1234567890-abcdefg.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=
