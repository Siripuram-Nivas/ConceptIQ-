# AI Provider: "demo" (default, offline) or "live" (requires API key)
VITE_AI_PROVIDER=demo

# ─── SERVER-SIDE ONLY — Never prefix with VITE_ ───────────────────────────────
# Add these to your server environment or .env.local — NEVER commit this file with real keys

# Required when VITE_AI_PROVIDER=live
# Get your key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Optional: override the Gemini model used for AI operations
# Default: gemini-2.0-flash
# GEMINI_MODEL=gemini-2.0-flash

# ─── Google Authentication (frontend, safe to expose) ────────────────────────
# Example: 1234567890-abcdefg.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=
